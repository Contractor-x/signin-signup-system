{
  "expo": {
    "name": "STILL",
    "slug": "still-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F2EFE7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.ashirtech.stillapp"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2EFE7",
          "image": "./assets/splash-icon.png",
          "imageWidth": 288,
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b88b047a-fbcb-4d6d-b52e-8fa887dfe825"
      }
    },
    "owner": "ashir-tech",
    "scheme": "stillapp"
  }
}
