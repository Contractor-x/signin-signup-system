{
  "expo": {
    "name": "STILL",
    "slug": "still-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F2EFE7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.ashirtech.stillapp"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2EFE7",
          "image": "./assets/splash-icon.png",
          "imageWidth": 288,
          "resizeMode": "contain"
        }
      ]
    ],
    "scheme": "stillapp",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "b06bbb30-419e-4fed-8788-941ed87e1f13"
      }
    }
  }
}
