# ============================================================
# Google OAuth
# ============================================================
# Create an OAuth 2.0 Client ID (Web) here:
#   https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret

# Callback URL must be added to the OAuth client's
# "Authorized redirect URIs" in Google Cloud Console.
# - Local dev:  http://localhost:8000/api/auth/callback
# - On Vercel:  https://your-app.vercel.app/api/auth/callback
#   (use the same domain the backend is served from)
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback

# ============================================================
# Supabase  (https://supabase.com/dashboard/project/_/settings/api)
# ============================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Server-only key (optional; used for writes that bypass RLS).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================
# Frontend  (Vercel deployment URL in production)
# ============================================================
# The page the browser returns to after a successful Google login.
# - Local dev:  http://localhost:5500  (Live Server)
# - On Vercel:  https://your-app.vercel.app
FRONTEND_URL=http://localhost:5500