# ============================================================
# Supabase  (https://supabase.com/dashboard/project/_/settings/api)
# ============================================================
# Copy this file to backend/.env (or backend/app/.env) and fill the values.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Server-only key (optional; used for writes that bypass RLS).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================
# Frontend  (Vercel deployment URL in production)
# ============================================================
# The page the browser returns to / the origin allowed by CORS.
# - Local dev:  http://localhost:5500  (Live Server)
# - Production: https://your-app.vercel.app
FRONTEND_URL=http://localhost:5500