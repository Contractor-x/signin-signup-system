# ============================================================
# Backend environment (keep on your machine, never commit real secrets)
# ============================================================

# Database
DB_PATH=./data/sandbox.db

# Session cookie lifetime in hours
SESSION_TTL_HOURS=24

# Set to 0 to disable the dev-only password-reset outbox endpoint
SANDBOX_DEV=1

# Where the frontend dev server runs (used for CORS)
FRONTEND_URL=http://localhost:5173
